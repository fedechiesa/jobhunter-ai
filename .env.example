# Local development only. Replace placeholders with generated values; never commit .env.
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_DB=jobhunter
POSTGRES_PORT=5432
TEST_POSTGRES_PASSWORD=replace_with_another_generated_password
TEST_POSTGRES_PORT=5433
# URL-encode special characters in passwords. The setup script uses URL-safe passwords.
DATABASE_URL=postgresql+psycopg://jobhunter:replace_with_generated_password@127.0.0.1:5432/jobhunter
TEST_DATABASE_URL=postgresql+psycopg://jobhunter_test:replace_with_another_generated_password@127.0.0.1:5433/jobhunter_test
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Public browser configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8000
